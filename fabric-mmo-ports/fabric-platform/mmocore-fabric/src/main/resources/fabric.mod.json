{
  "schemaVersion": 1,
  "id": "mmocorefabric",
  "version": "${version}",
  "name": "MMOCore Fabric",
  "environment": "server",
  "entrypoints": {
    "main": [
      "vn.svframe.mmocorefabric.MMOCoreDefaultConfigMod",
      "vn.svframe.mmocorefabric.MMOCoreFabricMod",
      "vn.svframe.mmocorefabric.MMOCoreProfessionExperienceMod",
      "vn.svframe.mmocorefabric.MMOCoreSpecialProfessionExperienceMod",
      "vn.svframe.mmocorefabric.MMOCoreRpgProfileMod",
      "vn.svframe.mmocorefabric.MMOCoreResourceMod",
      "vn.svframe.mmocorefabric.MMOCoreSocialMod"
    ]
  },
  "mixins": [
    "mmocorefabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "mythiclibfabric": ">=0.8.0-dev"
  }
}
