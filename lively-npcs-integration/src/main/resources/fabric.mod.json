{
  "schemaVersion": 1,
  "id": "livelynpcs_integration",
  "version": "${version}",
  "name": "Lively NPCs: Cobblemon Integration by SVFrame Studio",
  "description": "Cobblemon integration extension for Lively NPCs, including Pokemon bodies, trainer battle AI, world awareness and optional server-ecosystem bridges.",
  "authors": ["SVFrame Studio"],
  "environment": "*",
  "entrypoints": {
    "main": ["vn.svframe.lively.integration.LivelyNpcsIntegration"]
  },
  "mixins": [
    "livelynpcs-integration.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "livelynpcs": ">=0.4.0-rc1",
    "cobblemon": ">=1.7.3 <1.8.0"
  },
  "suggests": {
    "mega_showdown": "*",
    "luckperms": "*",
    "beconomy": "*",
    "holodisplays": "*",
    "flan": "*",
    "svfwaypoints": "*"
  }
}
