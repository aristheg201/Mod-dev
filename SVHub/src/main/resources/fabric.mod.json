{
  "schemaVersion": 1,
  "id": "svhub",
  "version": "${version}",
  "name": "SVHub",
  "description": "Responsive in-game hub with Arcade, Companion Arena, gacha, skins and Pokémon reference tools.",
  "authors": [
    "Aris"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.aristheg201.svhub.SVHubEntrypoint"
    ],
    "client": [
      "io.github.aristheg201.svhub.client.SVHubClientEntrypoint",
      "io.github.aristheg201.svhub.client.nativeui.NativePlatformClientEntrypoint"
    ]
  },
  "depends": {
    "java": ">=21",
    "minecraft": "~1.21.1",
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "cobblemon": ">=1.8.1",
    "mega_showdown": ">=1.2.0"
  },
  "suggests": {
    "fabric-permissions-api-v0": "*",
    "skiesskins": ">=1.1.0",
    "blanketeconomy": "*",
    "beconomy": "*"
  },
  "icon": "assets/svhub/icon.png",
  "mixins": [
    {
      "config": "svhub.client.mixins.json",
      "environment": "client"
    }
  ]
}
