    {
      "id": "ask",
      "topic": "ask",
      "profession": "*",
      "activity": "*",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "*",
      "text": "We have a bakery, a forge, a watch and a tavern. Our roads connect homes to work. Ask the innkeeper about cards."
