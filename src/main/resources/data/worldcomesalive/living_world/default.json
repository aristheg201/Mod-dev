      "profession": "*",
      "activity": "*",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "rain",
      "text": "This rain makes the road heavy. Travellers will be late."
    },
    {
      "id": "greet",
      "topic": "greet",
      "profession": "*",
      "activity": "*",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "*",
      "text": "Good day, {player}. May the road treat you kindly."
