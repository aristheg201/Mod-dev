  "dialogue": [
    {
      "id": "welcome",
      "topic": "talk",
      "profession": "*",
      "activity": "*",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "*",
      "text": "Welcome to {settlement}. The {faction} keeps these roads safe. I am {name}, the {profession}."
    },
    {
      "id": "work",
      "topic": "talk",
      "profession": "*",
      "activity": "working",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "*",
      "text": "I am {activity}. Our household lives in {home}; come by after my shift."
    },
    {
      "id": "social",
      "topic": "talk",
      "profession": "*",
      "activity": "socializing",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "*",
      "text": "A warm hearth, good company and a game of cards. That is what keeps {settlement} alive."
    },
    {
      "id": "guard",
      "topic": "talk",
      "profession": "guard",
      "activity": "*",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "*",
      "text": "My Growlithe helps me patrol the roads. Report trouble to the watch."
    },
    {
      "id": "farmer",
      "topic": "talk",
      "profession": "farmer",
      "activity": "*",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "*",
      "text": "My Wooloo and I tend the fields. The bakery depends on our wheat."
    },
    {
      "id": "baker",
      "topic": "talk",
      "profession": "baker",
      "activity": "*",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "*",
      "text": "Fresh bread for the village. If the roads close, flour gets scarce."
    },
    {
      "id": "smith",
      "topic": "talk",
      "profession": "blacksmith",
      "activity": "*",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "*",
      "text": "Vulpix keeps the forge hot. Tools, repairs and honest work."
    },
    {
      "id": "inn",
      "topic": "talk",
      "profession": "innkeeper",
      "activity": "*",
      "minTrust": -100,
      "memory": "",
      "season": "*",
      "weather": "*",
      "text": "Our card night begins after the work bell. Bring a deck and a friendly spirit."
    },
    {
      "id": "saved",
      "topic": "talk",
      "profession": "*",
      "activity": "*",
      "minTrust": 15,
      "memory": "helped",
      "season": "*",
      "weather": "*",
      "text": "I remember the help you gave our household. You have earned my trust."
    },
    {
      "id": "assault",
      "topic": "talk",
      "profession": "*",
      "activity": "*",
      "minTrust": -100,
      "memory": "assault",
      "season": "*",
      "weather": "*",
      "text": "Keep your distance. I remember what you did."
    },
    {
      "id": "rain",
